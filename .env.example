# Phase 5A browser configuration contract — no private secrets belong here.
RUPAI_AUTH_MODE=local-development
RUPAI_AUTH_PROVIDER=local
RUPAI_AUTH_PROVIDER_URL=
RUPAI_AUTH_PUBLIC_CLIENT_KEY=
RUPAI_AUTH_DEVELOPMENT_ADAPTER_ENABLED=true
RUPAI_AUTH_EMAIL_VERIFICATION_REQUIRED=false
RUPAI_AUTH_GUEST_MODE_ENABLED=true
RUPAI_AUTH_REGISTRATION_ENABLED=true
RUPAI_AUTH_PUBLIC_ROLE=student
RUPAI_AUTH_SESSION_DURATION_MINUTES=480

# Phase 5B persistence and synchronization contract.
RUPAI_PERSISTENCE_MODE=local-first
RUPAI_SYNC_ENABLED=false
RUPAI_PERSISTENCE_PROVIDER=local-device
RUPAI_PERSISTENCE_PROVIDER_URL=
RUPAI_PERSISTENCE_PUBLIC_CLIENT_KEY=
RUPAI_SYNC_OFFLINE_MODE=auto
RUPAI_SYNC_RETRY_LIMIT=5
RUPAI_SYNC_BATCH_SIZE=50
RUPAI_SYNC_INTERVAL_MINUTES=0
RUPAI_SYNC_CONFLICT_STRATEGY=review
RUPAI_SYNC_DEVELOPMENT_ADAPTER_ENABLED=false
RUPAI_SYNC_LOGGING_LEVEL=safe
RUPAI_DELETED_RECORD_RETENTION_DAYS=30
RUPAI_AUDIT_RETENTION_DAYS=180
RUPAI_EXPORT_EXPIRY_DAYS=7

# Phase 5C AI provider contracts. Private API keys must remain server-side.
RUPAI_AI_ENABLED=false
RUPAI_AI_DEFAULT_PROVIDER=
RUPAI_AI_PROVIDER_GATEWAY_URL=
RUPAI_AI_PUBLIC_CLIENT_CONFIG=
RUPAI_AI_DEFAULT_SAFETY_LEVEL=strict
RUPAI_AI_REQUEST_TIMEOUT_MS=30000
RUPAI_AI_MAXIMUM_RETRIES=1
RUPAI_AI_COST_POLICY=balanced
RUPAI_AI_PERFORMANCE_POLICY=balanced
RUPAI_AI_CACHE_ENABLED=true
